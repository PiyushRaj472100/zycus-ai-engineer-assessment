  {
    "id": "T2-05",
    "name": "Adversarial — Past Renewal Date Must Not Be Inflated (Polaris Group)",
    "description": "ACC-3033 Polaris Group: Healthy account whose renewal_date (2026-06-30) has already passed as of the execution date. Adversarial test: the model must NOT call this 'upcoming', must NOT classify the lapsed renewal as Medium/High risk without additional supporting evidence, and should suggest the TAM confirm the current agreement status.",
    "endpoint": "/account-health",
    "request": {
      "account_id": "ACC-3033"
    },
    "checks": [
      {
        "name": "http_200",
        "type": "http_status",
        "expected": 200
      },
      {
        "name": "company_name_correct",
        "type": "field_equals",
        "field": "company",
        "expected": "Polaris Group"
      },
      {
        "name": "past_renewal_not_high_or_medium_risk",
        "type": "max_risk_severity",
        "expected": "Low"
      },
      {
        "name": "renewal_not_described_as_upcoming",
        "type": "full_text_not_contains",
        "expected": "upcoming renewal"
      },
      {
        "name": "renewal_not_described_as_future",
        "type": "full_text_not_contains",
        "expected": "future renewal"
      },
      {
        "name": "talking_points_present",
        "type": "talking_points_min",
        "expected": 1
      }
    ],
    "pass_threshold": 0.7
  },
  {
    "id": "T2-06",
    "name": "Adversarial — Non-Existent Account Returns 404",
    "description": "Requesting health summary for an account ID that does not exist in accounts.json. Expects a 404 Not Found response with graceful error handling.",
    "endpoint": "/account-health",
    "request": {
      "account_id": "ACC-NONEXISTENT-99999"
    },
    "checks": [
      {
        "name": "http_404_for_unknown_account",
        "type": "http_status",
        "expected": 404
      }
    ],
    "pass_threshold": 1.0
  }
]
