[
  {
    "id": "T2-01",
    "name": "Healthy Account — Clean Profile (Endframe Analytics)",
    "description": "ACC-5108 Endframe Analytics: Healthy status, no escalation notes, no recent tickets, no NPS score. Expects a valid brief with no High/Medium risks and at least 2 talking points.",
    "endpoint": "/account-health",
    "request": {
      "account_id": "ACC-5108"
    },
    "checks": [
      {
        "name": "http_200",
        "type": "http_status",
        "expected": 200
      },
      {
        "name": "company_name_correct",
        "type": "field_equals",
        "field": "company",
        "expected": "Endframe Analytics"
      },
      {
        "name": "executive_summary_substantive",
        "type": "field_min_length",
        "field": "executive_summary",
        "expected": 80
      },
      {
        "name": "no_high_or_medium_risks_for_healthy_account",
        "type": "max_risk_severity",
        "expected": "Low"
      },
      {
        "name": "talking_points_present",
        "type": "talking_points_min",
        "expected": 2
      }
    ],
    "pass_threshold": 0.8
  },
  {
